{
  "name": "nagi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsc --project tsconfig.tests.json && node --test .qa/tests/tests/*.test.js",
    "test:routes": "node scripts/check-routes.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "admin:role": "node --conditions=react-server --import tsx scripts/admin-role.ts",
    "firebase:emulators": "firebase emulators:start --project demo-nagi",
    "test:firebase-rules": "firebase emulators:exec --project demo-nagi --only firestore,storage \"node --test tests/firebase-rules.test.mjs\"",
    "test:admin-auth": "firebase emulators:exec --project demo-nagi --only auth,firestore \"node scripts/check-admin-auth.mjs\"",
    "geography:import": "node --conditions=react-server --import tsx scripts/import-geography.ts",
    "test:geography": "firebase emulators:exec --project demo-nagi --only auth,firestore \"node --conditions=react-server --import tsx scripts/check-geography.mjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "client-only": "0.0.1",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "15.33.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
