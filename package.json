{
  "name": "nagi",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @nagi/web dev",
    "dev:bot": "pnpm --filter @nagi/bot dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:google-ui": "node tests/browser/google-places.mjs",
    "db:types": "node scripts/schema-types-from-migrations.mjs",
    "db:types:check": "node scripts/schema-types-from-migrations.mjs --check",
    "icons:generate": "node scripts/generate-lucide-icons.mjs",
    "icons:check": "node scripts/generate-lucide-icons.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "turbo": "2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.1.0"
  }
}
