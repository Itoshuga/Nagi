rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function published(data) {
      return data.status == 'published' && data.visibility == 'public' && data.archivedAt == null;
    }
    function publicCountry(id) {
      return exists(/databases/$(database)/documents/countries/$(id)) && published(get(/databases/$(database)/documents/countries/$(id)).data);
    }
    function publicCity(id) {
      let city = get(/databases/$(database)/documents/cities/$(id));
      return city != null && published(city.data) && publicCountry(city.data.countryId);
    }
    // Les écritures géographiques et réservations passent exclusivement par le
    // serveur autorisé : impossible de contourner Zod, l’unicité ou le gel des URL.
    match /countries/{id} {
      allow read: if isAdmin() || published(resource.data);
      allow write: if false;
    }
    match /cities/{id} {
      allow read: if isAdmin() || (published(resource.data) && publicCountry(resource.data.countryId));
      allow write: if false;
    }
    match /districts/{id} {
      allow read: if isAdmin() || (published(resource.data) && publicCity(resource.data.cityId));
      allow write: if false;
    }
    // Les fiches et relations sont projetées par le serveur après vérification
    // de TOUS les parents. Aucun accès public direct à un document complet.
    match /contents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /contentRelations/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Anciennes fondations conservées pour une conversion non destructive.
    match /{collection}/{id} {
      allow read: if collection in ['tourism', 'activities', 'food', 'addresses'] && isAdmin();
      allow write: if false;
    }
    // Registre photographique et verrous : uniquement l’Admin SDK serveur.
    match /photoAssets/{id} { allow read, write: if false; }
    match /photoUploadOwners/{id} { allow read, write: if false; }
    // geographySlugs, collections inconnues et sous-collections : refus implicite.
  }
}
