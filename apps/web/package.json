    "@tailwindcss/postcss": "4.3.5",
    "lucide-react": "^0.577.0",
    "motion": "^12.34.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
