# Copier ce fichier vers .env à la racine. Aucun secret réel ici.
# PUBLIC — peut être exposé au navigateur. Clé anon/legacy ou publishable Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVEUR UNIQUEMENT — jamais préfixer par NEXT_PUBLIC_. Web ET bot.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
DISCORD_APPLICATION_ID=000000000000000000
# guild pour les tests ; global pour la production. Un seul scope géré par processus.
DISCORD_COMMAND_SCOPE=guild
DISCORD_DEV_GUILD_ID=000000000000000000
# IDs numériques, séparés par des virgules. Même valeur sur web et bot.
NAGI_OWNER_DISCORD_IDS=

# BACKENDS WEB ET BOT. Intents du bot : Guilds ; aucun intent privilégié.
DISCORD_BOT_TOKEN=your-discord-bot-token

# WEB UNIQUEMENT : même secret que Supabase > Authentication > Providers > Discord.
DISCORD_CLIENT_SECRET=your-discord-oauth-secret
# Chiffrement des tokens Discord persistés. Générer UNE FOIS avec : openssl rand -base64 32
# Conserver la même clé après redémarrage / déploiement. Jamais de NEXT_PUBLIC_.
NAGI_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key
# Taille maximale des couvertures JPEG, PNG ou WebP, entre 1 et 8 Mo (8 par défaut).
# NAGI_COVER_MAX_MIB=8

# Optionnel pour la CLI Supabase (connexion au compte et liaison du projet).
# SUPABASE_PROJECT_ID=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-supabase-cli-access-token
# Communication web/bot : file PostgreSQL sous RLS, authentifiée par Supabase.
# Aucun endpoint HTTP de déploiement ni secret de communication supplémentaire.
# Mapbox — facultatif. Réutiliser les tokens Nagi Server et Nagi Browser.
# Seul le token Browser public apparaît dans les URL des tuiles.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
MAPBOX_ENABLED=false
MAPBOX_USER_DAILY_LIMIT=500
MAPBOX_GLOBAL_DAILY_LIMIT=5000
MAPBOX_USER_MINUTE_LIMIT=60
MAPBOX_MIN_CHARACTERS=3
# Places Details Public Preview : plafond Nagi inférieur à 1000/mois/compte.
MAPBOX_DETAILS_MONTHLY_LIMIT=900
# Photographies : Serper principal, Wikidata / Commons / Openverse en repli.
SERPER_API_KEY=
SERPER_IMAGES_ENABLED=true
# Dix résultats fixes, un seul appel par lieu. Les anciennes tailles sont ignorées.
SERPER_IMAGES_PAGE_SIZE=10
# Compatibilité : la pagination payante reste désactivée, quelles que soient ces valeurs.
SERPER_IMAGES_MAX_PAGES=1
SERPER_IMAGES_MAX_TOTAL_PAGES=1
SERPER_IMAGES_MAX_CONCURRENT_REQUESTS=1
SERPER_IMAGES_GLOBAL_DAILY_LIMIT=50
# Plafond individuel des membres ; les administrateurs utilisent le plafond global.
SERPER_IMAGES_USER_DAILY_LIMIT=20
SERPER_IMAGES_USER_MINUTE_LIMIT=6
NAGI_IMAGE_RESOLVER_ENABLED=true
# Prévisualisation privée administrateur, uniquement avec NODE_ENV=development.
# Toujours ignorée par le serveur de production, même si configurée à true.
NAGI_IMAGE_PREVIEW_UNVERIFIED=false
NAGI_IMAGE_MAX_CONCURRENT_REQUESTS=2
NAGI_IMAGE_DIAGNOSTICS=false
# Anciens providers photo exclus du résolveur. Mapbox reste géographique.
MAPBOX_PHOTOS_ENABLED=false
MAPBOX_PLACES_PHOTOS_ENABLED=false
FOURSQUARE_PHOTOS_ENABLED=false

# Identité de l’exploitant et contact publiés sur /privacy et /terms.
NAGI_SERVICE_OPERATOR=
NAGI_PRIVACY_CONTACT=
# Open photographic metadata (server only); identify the operator to Wikimedia.
NAGI_IMAGE_USER_AGENT="NagiImageResolver/1.0 (mailto:contact@example.com)"
# Alternative au User-Agent personnalisé ; conserver le contact existant s’il est défini.
WIKIMEDIA_CONTACT_EMAIL=
# Optional Openverse OAuth application, never exposed to the browser.
NAGI_OPENVERSE_CLIENT_ID=
NAGI_OPENVERSE_CLIENT_SECRET=
