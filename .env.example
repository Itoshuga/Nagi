# Copier ce fichier vers .env à la racine. Aucun secret réel ici.
# PUBLIC — peut être exposé au navigateur. Clé anon/legacy ou publishable Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVEUR UNIQUEMENT — jamais préfixer par NEXT_PUBLIC_. Web ET bot.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
DISCORD_APPLICATION_ID=000000000000000000
# guild pour les tests ; global pour la production. Un seul scope géré par processus.
DISCORD_COMMAND_SCOPE=guild
DISCORD_DEV_GUILD_ID=000000000000000000
# IDs numériques, séparés par des virgules. Même valeur sur web et bot.
NAGI_OWNER_DISCORD_IDS=

# BACKENDS WEB ET BOT. Intents du bot : Guilds ; aucun intent privilégié.
DISCORD_BOT_TOKEN=your-discord-bot-token

# WEB UNIQUEMENT : même secret que Supabase > Authentication > Providers > Discord.
DISCORD_CLIENT_SECRET=your-discord-oauth-secret
# Chiffrement des tokens Discord persistés. Générer UNE FOIS avec : openssl rand -base64 32
# Conserver la même clé après redémarrage / déploiement. Jamais de NEXT_PUBLIC_.
NAGI_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key
# Taille maximale des couvertures JPEG, PNG ou WebP, entre 1 et 8 Mo (8 par défaut).
# NAGI_COVER_MAX_MIB=8

# Optionnel pour la CLI Supabase (connexion au compte et liaison du projet).
# SUPABASE_PROJECT_ID=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-supabase-cli-access-token
# Communication web/bot : file PostgreSQL sous RLS, authentifiée par Supabase.
# Aucun endpoint HTTP de déploiement ni secret de communication supplémentaire.
# Google Places — facultatif. Deux clés distinctes, jamais de clé serveur en NEXT_PUBLIC.
# EEE : résultats et détails affichés par Places UI Kit ; aucune copie du contenu Google.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_USER_DAILY_LIMIT=150
GOOGLE_PLACES_GLOBAL_DAILY_LIMIT=2000
GOOGLE_PLACES_USER_MINUTE_LIMIT=20
GOOGLE_PLACES_MIN_CHARACTERS=3
# Identité de l’exploitant et contact publiés sur /privacy et /terms.
NAGI_SERVICE_OPERATOR=
NAGI_PRIVACY_CONTACT=
