# Origine publique utilisée pour les URL canoniques au build.
# Remplacer par le domaine réel avant un déploiement public.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origine exacte autorisée pour les mutations de session (HTTPS en production).
# Doit correspondre à l’URL utilisée dans le navigateur, sans chemin.
ADMIN_APP_ORIGIN=http://localhost:3000

# Configuration de l’application Web Firebase (publique, intégrée au build).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Compte de service : serveur Node.js uniquement. Ne jamais versionner les valeurs.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Coller le PEM entre guillemets ; les retours à la ligne peuvent être encodés en \n.
FIREBASE_ADMIN_PRIVATE_KEY=

# Développement local seulement ; voir docs/FIREBASE.md pour le projet demo-nagi.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# À définir uniquement avec les émulateurs, à supprimer en production :
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Source des destinations publiques. Passer à firestore après migration validée.
NAGI_GEOGRAPHY_SOURCE=static

# Source des fiches publiques. Exige la géographie Firestore et un import validé.
NAGI_CONTENT_SOURCE=static

# Photographies : serveur uniquement, entre 100 000 et 25 000 000 octets.
NAGI_PHOTO_MAX_BYTES=5000000

# Secret serveur du nettoyage Vercel quotidien (32 caractères minimum).
CRON_SECRET=
