# =============================================================================
# NAGI — Modèle de configuration
# =============================================================================
# Copier ce fichier vers .env à la racine, puis renseigner les valeurs.
# Seules les variables NEXT_PUBLIC_ sont destinées au navigateur.
# Utiliser uniquement des exemples ici ; les secrets restent dans .env.

# -----------------------------------------------------------------------------
# APPLICATION — Adresse et fichiers
# -----------------------------------------------------------------------------

# URL publique du site, utilisée notamment pour les redirections.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facultatif : taille maximale des couvertures, de 1 à 8 Mo (8 par défaut).
# NAGI_COVER_MAX_MIB=8

# -----------------------------------------------------------------------------
# SUPABASE — Base de données et authentification
# -----------------------------------------------------------------------------

# URL et clé publique accessibles au navigateur (clé anon ou publishable).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Clé privilégiée réservée aux serveurs web et bot.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# -----------------------------------------------------------------------------
# DISCORD — Application, bot et connexion OAuth
# -----------------------------------------------------------------------------

# Identifiant de la même application Discord pour le web, le bot et Supabase.
DISCORD_APPLICATION_ID=000000000000000000

# Token du bot utilisé par les backends web et bot. Intent requis : Guilds.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Secret OAuth utilisé par le web pour renouveler les tokens Discord.
# Doit correspondre au secret configuré dans Supabase > Authentication > Discord.
DISCORD_CLIENT_SECRET=your-discord-oauth-secret

# Portée des commandes : guild pour les tests, global pour la production.
DISCORD_COMMAND_SCOPE=guild

# Serveur Discord de test utilisé lorsque la portée vaut guild.
DISCORD_DEV_GUILD_ID=000000000000000000

# Identifiants Discord des propriétaires, séparés par des virgules.
NAGI_OWNER_DISCORD_IDS=

# Chiffrement des tokens persistés : clé AES-256-GCM de 32 octets en Base64.
# Générer une seule fois avec : openssl rand -base64 32
# Conserver la même clé lors des redémarrages et des déploiements.
NAGI_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# -----------------------------------------------------------------------------
# MAPBOX — Carte et recherche de lieux
# -----------------------------------------------------------------------------

# Token Browser public pour la carte ; token Server réservé au backend.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
MAPBOX_ENABLED=false

# Plafonds de recherche par utilisateur, pour le service et par minute.
MAPBOX_USER_DAILY_LIMIT=500
MAPBOX_GLOBAL_DAILY_LIMIT=5000
MAPBOX_USER_MINUTE_LIMIT=60

# Nombre minimal de caractères avant une recherche.
MAPBOX_MIN_CHARACTERS=3

# Plafond mensuel Nagi pour Places Details Public Preview, inférieur à 1 000.
MAPBOX_DETAILS_MONTHLY_LIMIT=900

# -----------------------------------------------------------------------------
# IMAGES — Réglages généraux et développement
# -----------------------------------------------------------------------------

# Activation du résolveur et nombre maximal de requêtes simultanées.
NAGI_IMAGE_RESOLVER_ENABLED=true
NAGI_IMAGE_MAX_CONCURRENT_REQUESTS=2

# Journaux de diagnostic du résolveur.
NAGI_IMAGE_DIAGNOSTICS=false

# Aperçu privé des images non vérifiées : administrateur en développement uniquement.
# Toujours ignoré en production, même si cette valeur est true.
NAGI_IMAGE_PREVIEW_UNVERIFIED=false

# -----------------------------------------------------------------------------
# SERPER — Bibliothèque de dix photos par lieu
# -----------------------------------------------------------------------------

# Clé API réservée au serveur et activation de la recherche photographique.
SERPER_API_KEY=
SERPER_IMAGES_ENABLED=true

# Compatibilité : le code impose dix résultats et une seule page par lieu.
# Aucun rechargement forcé ; les photos sont conservées en base et réutilisées.
SERPER_IMAGES_PAGE_SIZE=10
SERPER_IMAGES_MAX_PAGES=1
SERPER_IMAGES_MAX_TOTAL_PAGES=1

# Nombre maximal de recherches Serper simultanées.
SERPER_IMAGES_MAX_CONCURRENT_REQUESTS=1

# Plafond quotidien partagé par l’ensemble du service.
SERPER_IMAGES_GLOBAL_DAILY_LIMIT=50

# Plafond quotidien des membres ; les administrateurs utilisent le plafond partagé.
SERPER_IMAGES_USER_DAILY_LIMIT=20

# Plafond par utilisateur et par minute.
SERPER_IMAGES_USER_MINUTE_LIMIT=6

# -----------------------------------------------------------------------------
# IMAGES — Sources de repli Wikimedia et Openverse
# -----------------------------------------------------------------------------

# Contact technique envoyé à Wikimedia pour identifier le résolveur.
WIKIMEDIA_CONTACT_EMAIL=

# Facultatif : User-Agent personnalisé, prioritaire sur le contact ci-dessus.
NAGI_IMAGE_USER_AGENT="NagiImageResolver/1.0 (mailto:contact@example.com)"

# Identifiants OAuth Openverse facultatifs, réservés au serveur.
NAGI_OPENVERSE_CLIENT_ID=
NAGI_OPENVERSE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# IMAGES — Anciens adaptateurs photo (compatibilité)
# -----------------------------------------------------------------------------

# Réglages historiques conservés. Le parcours courant utilise Serper et les sources de repli.
MAPBOX_PHOTOS_ENABLED=false

# Adaptateur photo Mapbox : activation et références des droits d’utilisation.
MAPBOX_PLACES_PHOTOS_ENABLED=false

# Activation de l’ancien adaptateur photo Foursquare.
FOURSQUARE_PHOTOS_ENABLED=false

# -----------------------------------------------------------------------------
# INFORMATIONS LÉGALES — Exploitant et contact public
# -----------------------------------------------------------------------------

# Informations affichées sur les pages /terms et /privacy.
NAGI_SERVICE_OPERATOR=
NAGI_PRIVACY_CONTACT=

# -----------------------------------------------------------------------------
# OUTILS — Supabase CLI (facultatif)
# -----------------------------------------------------------------------------

# Connexion au compte Supabase et liaison du projet pour les commandes CLI.
# SUPABASE_PROJECT_ID=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-supabase-cli-access-token
